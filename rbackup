#!/usr/bin/env elvish
# vim: set ft=elvish:

use rbackup/flag rbackup-flag
use rbackup/rclone
use rbackup/io
use rbackup/zip
use rbackup/openssl
use os
use path
use str

var subcommands = [
  &generate=[
    &f={|paths opts|
      if (not (has-env RBACKUP_ENCRYPT_PASSWORD)) {
        fail "encrypt password not set."
      }
      var expanded-paths = []
      for p $paths {
        if (eq $p "-") {
          set expanded-paths = [$@expanded-paths (io:read-stdin)]
        } else {
          set expanded-paths = [$@expanded-paths $p]
        }
      }
      if (and (== (count $expanded-paths) 0) (has-env RBACKUP_PATHS)) {
        set expanded-paths = [(str:split $path:list-separator $E:RBACKUP_PATHS)]
      }
      if (== (count $expanded-paths) 0) {
        fail "you need to specify a path."
      }
      var date-suffix = (date +'%Y%m%d%H%M%S')
      var backup-target-path = '/tmp/'$opts[prefix]'-'$date-suffix'.zip'
      var encrypted-backup-target-path = '/tmp/'$opts[prefix]'-'$date-suffix'.zip.enc'
      zip:compact &junk-paths=$opts[junk-paths] $backup-target-path $expanded-paths >&2
      openssl:encrypt $backup-target-path $encrypted-backup-target-path $E:RBACKUP_ENCRYPT_PASSWORD
      du -shL $encrypted-backup-target-path >&2
      rclone:upload $opts[remote] $encrypted-backup-target-path >&2
      echo (basename $encrypted-backup-target-path)
    }
    &usage="rbackup generate [--remote REMOTE:FOLDER/PATH] [-p|--prefix PREFIX] [-j|--junk-paths]"
    &requires-remote=$true
  ]
  &gc=[
    &f={|_ opts|
      var files = [(rclone:fetch-files $opts[remote] $opts[prefix])]
      var keep-count = (num $opts[keep-count])
      var files-to-garbage-collect = []
      if (> (count $files) $keep-count) {
        set files-to-garbage-collect = $files[$keep-count..]
      }
      if (== (count $files-to-garbage-collect) 0) {
        echo 'no files to purge.' >&2
        return
      }
      echo 'deleting '(count $files-to-garbage-collect)' files' >&2
      if (put $opts[dry-run]) {
        echo 'this is a dry-run, listed files were not actually removed.' >&2
        return
      }
      peach {|file|
        rclone:remove $opts[remote] $file
        echo $file
      } $files-to-garbage-collect
    }
    &usage="rbackup gc [--remote REMOTE:FOLDER/PATH] [-p|--prefix PREFIX] [--keep NUM] [--dry-run]"
    &requires-remote=$true
  ]
  &fetch=[
    &f={|positionals opts|
      var index = (num $opts[index])
      var files = [(rclone:fetch-files $opts[remote] $opts[prefix])]
      if (< (count $files) $index) {
        fail "index not found."
      }
      var file-name = $files[$index]
      var target-dir = (os:temp-dir)
      echo 'fetching '$file-name >&2
      var backup-file-path = (rclone:fetch $opts[remote] $file-name $target-dir)
      echo $backup-file-path
    }
    &usage="rbackup fetch [--remote REMOTE:FOLDER/PATH] [-p|--prefix PREFIX] [-i|--index INDEX]"
    &requires-remote=$true
  ]
  &decrypt=[
    &f={|paths opts|
      if (or (== (count $paths) 0) (> (count $paths) 1)) {
        fail "you need to specify just one path."
      }
      var path = $paths[0]
      var target-dir = (os:temp-dir)
      var decrypted-file-path = $target-dir$path:separator'decrypted.zip'
      openssl:decrypt $path $decrypted-file-path $E:RBACKUP_ENCRYPT_PASSWORD >&2
      var target-unwrapped-dir = $target-dir$path:separator'target'
      zip:extract $decrypted-file-path $target-unwrapped-dir >&2
      echo $target-unwrapped-dir
    }
    &usage="rbackup decrypt FILE"
    &requires-remote=$false
  ]
  &delete=[
    &f={|positionals opts|
      var index = (num $opts[index])
      var files = [(rclone:fetch-files $opts[remote] $opts[prefix])]
      if (< (count $files) $index) {
        fail "index not found."
      }
      var file-name = $files[$index]
      rclone:remove $opts[remote] $file-name
      echo $file-name
    }
    &usage="rbackup delete [--remote REMOTE:FOLDER/PATH] [-p|--prefix PREFIX] [-i|--index INDEX]"
    &requires-remote=$true
  ]
  &version=[
    &f={|_ _|
      echo $E:RBACKUP_VERSION'-'$E:RBACKUP_GIT_SHA
    }
    &usage="rbackup version"
    &requires-remote=$false
  ]
]
fn main {
  var opts subcommand paths = (rbackup-flag:parse $@args)
  var has-subcommand = (has-key $subcommands $subcommand)
  if (and (put $opts[help]) (not $has-subcommand)) {
    echo 'Simple rclone wrapper for managing backups.'
    echo "\nUsage: rbackup [FLAGS] subcommand"
    echo "\nSubcommands: generate gc fetch decrypt delete version"
    exit 0
  }

  if (eq $subcommand "") {
    fail "a valid subcommand is necessary."
  }

  var action = $subcommands[$subcommand]
  if (put $opts[help]) {
    echo 'Usage: '$action[usage]
    exit 0
  }

  if (and (eq $opts[remote] "") (put $action[requires-remote])) {
    fail "you need to specify the rclone remote."
  }

  var f~ = $action[f]
  $f~ $paths $opts
}

var e = ?(main)
if (not-eq $e $ok) {
  if (eq (kind-of $e[reason]) fail-error) {
    echo $e[reason][content] >&2
    exit 1
  }
  fail $e
}
