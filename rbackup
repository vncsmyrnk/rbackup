#!/usr/bin/env elvish
# vim: set ft=elvish:

use rbackup/flag rbackup-flag
use rbackup/rclone

var subcommands = [
  &generate=[
    &f={|paths opts|
      if (== (count $paths) 0) {
        fail "you need to specify a path."
      }
      rclone:backup $opts[remote] $paths
    }
    &usage="rbackup generate [--remote REMOTE:FOLDER/PATH]"
  ]
  &gc=[
    &f={|_ opts|
      rclone:purge-garbage-collected $opts[remote] $opts[keep-count]
    }
    &usage="rbackup gc [--remote REMOTE:FOLDER/PATH] [--keep NUM]"
  ]
]
var opts positional = (rbackup-flag:parse $@args)

var has-subcommand = (has-key $subcommands $positional[0])
if (and (put $opts[help]) (not $has-subcommand)) {
  echo 'Simple rclone wrapper for managing backups.'
  echo "\nUsage: rbackup [FLAGS] subcommand"
  echo "\nSubcommands: generate gc"
  exit 0
}

if (or (== (count $positional) 0) (not (has-key $subcommands $positional[0]))) {
  fail "a valid subcommand is necessary."
}
var subcommand positional-paths = $positional[0] $positional[1..]

var action = $subcommands[$subcommand]
if (put $opts[help]) {
  echo 'Usage: '$action[usage]
  exit 0
}

if (eq $opts[remote] "") {
  fail "you need to specify the rclone remote."
}

var f~ = $action[f]
$f~ $positional-paths $opts
