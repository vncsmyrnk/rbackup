#compdef rbackup

# vim: set ft=sh:

function _rbackup_gc() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(-r --remote)'{-r,--remote}'=[rclone remote]:string:' \
    '(-h --help)'{-h,--help}'[Displays help message]'
}

function _rbackup_generate() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(-r --remote)'{-r,--remote}'=[rclone remote]:string:' \
    '(-h --help)'{-h,--help}'[Displays help message]'
}

function _rbackup() {
  local context state state_descr line
  typeset -A opt_args
  local ret=1

  _arguments -C \
    '(-r --remote)'{-r,--remote}'=[rclone remote]:string:' \
    '(-h --help)'{-h,--help}'[Displays help message]' \
    '1: :->action' \
    '*:: :->args' && ret=0

  case $state in
  action)
    local -a choices
    choices=(
      'generate'
      'gc'
    )
    _describe 'commands' choices && ret=0
    ;;
  args)
    case $line[1] in
    generate)
      _rbackup_generate "$@" && ret=0
      ;;
    gc)
      _rbackup_gc "$@" && ret=0
      ;;
    esac
    ;;
  esac

  return ret
}

compdef _rbackup rbackup
